OPENROUTER_API_KEY=sk-or-v1-...
# Optional; defaults to openai/gpt-4o-mini (text + vision in one model).
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional site metadata for OpenRouter rankings.
# OPENROUTER_HTTP_REFERER=https://yoursite.example
# OPENROUTER_APP_TITLE=Caliber

# Send question crops as images with the text prompt (default on). Set 0 to text-only.
# OPENROUTER_SEND_IMAGES=1
# OPENROUTER_VISION=1
