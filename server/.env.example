OPENROUTER_API_KEY=sk-or-v1-...
# Optional; defaults to openai/gpt-4o-mini (text + vision in one model).
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional HTTP read timeouts (seconds) for OpenRouter. Verify defaults lower than generation.
# OPENROUTER_TIMEOUT=90
# OPENROUTER_TIMEOUT_VERIFY=55
# Retries for transient TLS / connection errors (default 3).
# OPENROUTER_HTTP_RETRIES=3
# Optional caps on prompt size (characters).
# GENERATION_SOURCE_MAX_CHARS=26000
# VERIFY_VARIANT_TEXT_MAX_CHARS=14000
# Optional site metadata for OpenRouter rankings.
# OPENROUTER_HTTP_REFERER=https://yoursite.example
# OPENROUTER_APP_TITLE=Caliber

# Send question crops as images with the text prompt (default on). Set 0 to text-only.
# OPENROUTER_SEND_IMAGES=1
# OPENROUTER_VISION=1
